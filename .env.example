# TripBot 環境變數範例 —— 複製為 .env（本機）或填入 Vercel/GitHub Secrets
# 金鑰產生：python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- 爬蟲 ---
# 市場清單（逗號分隔）。留空＝tw,hk,jp,kr,sg,th,us 全跑；單一市場除錯用 tw
TRIPBOT_MARKETS=tw

# --- LINE Messaging API（https://developers.line.biz/console/）---
# Long-lived channel access token（Messaging API > Messaging API 發行）
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret（Basic settings）；webhook 驗章用，僅 Vercel 需要
LINE_CHANNEL_SECRET=

# --- 訂閱加密（Vercel 與 GitHub Secrets 必須同一個值）---
SUBS_FERNET_KEY=

# --- Vercel → GitHub repository_dispatch 用（fine-grained PAT：本 repo Contents R/W）---
GH_TOKEN=
GH_REPO=owner/repo

# --- /api/cron_remind Bearer 驗證（Vercel cron 自動帶 Authorization header）---
CRON_SECRET=

# --- 營運告警（選填）---
# healthchecks.io check URL（成功 ping 主址、失敗 ping /fail）
HEALTHCHECKS_URL=
# ntfy.sh topic（例：https://ntfy.sh/tripbot-xxxxx-請改隨機字串防偷看）
NTFY_TOPIC_URL=
